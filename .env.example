# 장비 규격 AI 검색용 설정 (서버에서만 사용됩니다)
# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 GitHub에 올라가지 않습니다.
# 배포(Vercel)에서는 같은 이름으로 프로젝트 Settings > Environment Variables 에 넣으세요.
GNU_RAG_API_KEY=여기에_API_키
GNU_RAG_API_BASE=https://hello.timelygpt.co.kr/api/v2/chat/bridge/openai
GNU_RAG_API_MODEL=anthropic/claude-sonnet-5.5
